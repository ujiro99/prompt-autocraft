{
  "TestPage": {
    "serviceName": "TestPage",
    "selectors": {
      "textInput": ["div[contenteditable='true'].ql-editor"],
      "sendButton": ["form button[type='submit']"]
    },
    "popupPlacement": {
      "alignOffset": -10,
      "sideOffset": 22
    }
  },
  "ChatGPT": {
    "serviceName": "ChatGPT",
    "selectors": {
      "textInput": ["[contenteditable='true']", "#mobile-composer-prompt"],
      "sendButton": [
        "form button[type='submit']",
        "button[data-composer-submit]",
        "button:has(svg.icon-primary-action)"
      ]
    },
    "popupPlacement": {
      "alignOffset": -20,
      "sideOffset": 22
    }
  },
  "Gemini": {
    "serviceName": "Gemini",
    "selectors": {
      "textInput": [".ql-editor[contenteditable='true']"],
      "sendButton": [
        "[data-test-id='send-button-container'] button",
        "button mat-icon[fonticon='arrow_upward']",
        "button mat-icon[fonticon='mic']"
      ]
    },
    "popupPlacement": {
      "alignOffset": -20,
      "sideOffset": 28
    }
  },
  "Claude": {
    "serviceName": "Claude",
    "selectors": {
      "textInput": [
        "div[contenteditable='true'][aria-label]",
        "div[contenteditable='true'].ProseMirror"
      ],
      "sendButton": [
        "button:has(span.bg-fill-brand)",
        "[data-cds='SplitDropdownButton'] button"
      ]
    },
    "popupPlacement": {
      "alignOffset": -14,
      "sideOffset": 22
    }
  },
  "Perplexity": {
    "serviceName": "Perplexity",
    "selectors": {
      "textInput": [
        "div#ask-input",
        "div[contenteditable='true'][role='textbox']"
      ],
      "sendButton": [
        "button[type='button']:has(use[*|href='#pplx-icon-custom-perplexity-v2v'])",
        "button[type='button']:has(use[*|href='#pplx-icon-arrow-up'])",
        "button[type='button']:has(use[*|href^='#pplx-icon-arrow-right'])",
        "button[type='button']:has(use[*|href^='#pplx-icon-player-stop-filled'])",
        "button[aria-label='Submit']"
      ]
    },
    "popupPlacement": {
      "alignOffset": -16,
      "sideOffset": 20
    }
  },
  "Skywork": {
    "serviceName": "Skywork",
    "selectors": {
      "textInput": [".el-textarea div[contenteditable='true']"],
      "sendButton": [".footer-container .footer-right svg.cursor-pointer"]
    },
    "popupPlacement": {
      "alignOffset": -18,
      "sideOffset": 14
    }
  },
  "Stable Diffusion": {
    "serviceName": "Stable Diffusion",
    "selectors": {
      "textInput": ["form input", "textarea#prompts"],
      "sendButton": ["form button.bg-primary", "main button.font-caption"]
    },
    "popupPlacement": {
      "alignOffset": 0,
      "sideOffset": 4
    }
  }
}
